# opencode-typescript runtime environment template.
#
# Copy this file to .env (next to the project) or to
# ~/.config/opencode-container/env, fill in the values, and pass it to the
# container with --env-file (or to a Kubernetes Secret). Secrets live only on
# the host; they are never baked into the image. Keep the file readable only by
# you (chmod 600) and never commit it.
#
# The same template is baked into the image at /home/opencode/.env.example; the
# built-in env-setup agent skill offers to copy it into the working folder when
# required variables are missing.

# API key for the default provider (OpenRouter). Required for the default
# model: without it the agent has no model to talk to.
OPENROUTER_API_KEY=

# Password for the OpenCode server (HTTP API). Optional: when empty, the server
# generates a random password and prints it to the container log on start. API
# clients use Basic auth with the username "opencode".
# OPENCODE_PASSWORD=

# GitHub token for git over HTTPS, the gh CLI and API calls. Optional; when
# set, the entrypoint configures git to use it via `gh auth setup-git`.
# GH_TOKEN=

# Agent identity for git commits. These are the standard git environment
# variables and take precedence over the gitconfig baked into the image.
# Optional; sensible defaults are baked in.
# GIT_AUTHOR_NAME=
# GIT_AUTHOR_EMAIL=
# GIT_COMMITTER_NAME=
# GIT_COMMITTER_EMAIL=
