# opencode-typescript runtime environment template.
#
# Copy this file to .env (next to the project) or to
# ~/.config/opencode-typescript/env, fill in the values, and pass it to the
# container with --env-file (or to a Kubernetes Secret). The opencode-ts
# launcher finds it automatically. Secrets live only on the host or on the
# opencode-state volume; they are never baked into the image. Keep the file
# readable only by you (chmod 600) and never commit it.
#
# The same template is baked into the image at /home/opencode/.env.example; the
# built-in env-setup agent skill offers to copy it into the working folder when
# required variables are missing.

# API key for OpenRouter models. Optional: without it the session runs on
# OpenCode's free built-in models, which need no account or key. After
# connecting, pick a model in the TUI's model picker. Alternative: a
# one-time `opencode auth login openrouter` — the stored key wins over this
# variable.
OPENROUTER_API_KEY=

# Password for the OpenCode server in serve mode (HTTP API and web UI). The
# interactive TUI mode does not use it. Optional: when empty, the server
# generates a random password and prints it to the container log on start.
# API clients use Basic auth with the username "opencode".
# OPENCODE_PASSWORD=

# GitHub token for git over HTTPS, the gh CLI and API calls. Optional; when
# set, the entrypoint configures git to use it via `gh auth setup-git`.
# GH_TOKEN=

# GitLab token for git over HTTPS, the glab CLI and API calls. Optional; when
# set, the entrypoint stores it as a git credential for the GitLab host
# (gitlab.com by default, override with GITLAB_URL for self-hosted).
# GITLAB_TOKEN=
# GITLAB_URL=

# Forgejo (or Gitea) instance URL and token for git over HTTPS/HTTP and the
# REST API. Optional; the token is used only together with FORGEJO_URL.
# FORGEJO_URL=
# FORGEJO_TOKEN=

# Agent identity for git commits. These are the standard git environment
# variables and take precedence over the gitconfig baked into the image.
# Optional; sensible defaults are baked in.
# GIT_AUTHOR_NAME=
# GIT_AUTHOR_EMAIL=
# GIT_COMMITTER_NAME=
# GIT_COMMITTER_EMAIL=
